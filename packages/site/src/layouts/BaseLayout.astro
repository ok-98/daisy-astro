---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import { ThemeController } from 'daisy-astro';
import { homeHref } from '../lib/registry';

interface Props {
  title: string;
  description: string;
  /** Slug of the component page currently open, to highlight it in the sidebar. */
  currentSlug?: string;
}

const { title, description, currentSlug } = Astro.props;
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — daisy-astro</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Ctext y='20' font-size='20'%3E%F0%9F%8C%BC%3C/text%3E%3C/svg%3E" />
  </head>
  <body class="min-h-screen bg-base-100 text-base-content">
    <div class="drawer lg:drawer-open">
      <input id="sidebar-toggle" type="checkbox" class="drawer-toggle" />
      <div class="drawer-content flex flex-col">
        <div class="navbar border-b border-base-300 lg:hidden">
          <label for="sidebar-toggle" class="btn btn-square btn-ghost" aria-label="Open navigation">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </label>
          <span class="ml-2 font-semibold">daisy-astro</span>
        </div>
        <main class="mx-auto w-full max-w-4xl flex-1 px-6 py-10">
          <slot />
        </main>
      </div>
      <div class="drawer-side z-20">
        <label for="sidebar-toggle" aria-label="Close navigation" class="drawer-overlay"></label>
        <div class="min-h-full w-72 border-r border-base-300 bg-base-100 p-4">
          <div class="mb-4 flex items-center justify-between px-2">
            <a href={homeHref()} class="text-lg font-bold">daisy-astro</a>
            <label class="swap swap-rotate btn btn-ghost btn-sm btn-circle" aria-label="Toggle dark mode">
              <ThemeController type="checkbox" theme="dark" />
              <svg class="swap-off h-5 w-5 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M5.64 17l-.71.71a1 1 0 101.41 1.41l.71-.71A1 1 0 005.64 17zM5 12a1 1 0 00-1-1H3a1 1 0 000 2h1a1 1 0 001-1zm7-7a1 1 0 001-1V3a1 1 0 00-2 0v1a1 1 0 001 1zm10 6h-1a1 1 0 000 2h1a1 1 0 000-2zm-1.64-5.64a1 1 0 000-1.41 1 1 0 00-1.41 0l-.71.71a1 1 0 101.41 1.41zM12 6a6 6 0 106 6 6 6 0 00-6-6zm6.36 12.36a1 1 0 001.41-1.41l-.71-.71a1 1 0 10-1.41 1.41zM12 18a1 1 0 00-1 1v1a1 1 0 002 0v-1a1 1 0 00-1-1z"/></svg>
              <svg class="swap-on h-5 w-5 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Z"/></svg>
            </label>
          </div>
          <Sidebar currentSlug={currentSlug} />
        </div>
      </div>
    </div>
  </body>
</html>
