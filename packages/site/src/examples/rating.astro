---
import { Rating } from 'daisy-astro';
---

<Rating size="lg">
  <input type="radio" name="rating-1" class="mask mask-star-2" aria-label="1 star" />
  <input type="radio" name="rating-1" class="mask mask-star-2" aria-label="2 star" />
  <input type="radio" name="rating-1" class="mask mask-star-2" aria-label="3 star" checked />
  <input type="radio" name="rating-1" class="mask mask-star-2" aria-label="4 star" />
  <input type="radio" name="rating-1" class="mask mask-star-2" aria-label="5 star" />
</Rating>
