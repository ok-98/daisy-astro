---
import { Fieldset, FieldsetLegend, Label } from 'daisy-astro';
---

<Fieldset class="w-xs bg-base-200 border border-base-300 p-4 rounded-box">
  <FieldsetLegend>Page title</FieldsetLegend>
  <input type="text" class="input" placeholder="My awesome page" />
  <Label as="p">You can edit page title later on from settings</Label>
</Fieldset>
