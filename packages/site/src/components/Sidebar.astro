---
import { componentsByCategory } from '../lib/registry';

interface Props {
  currentSlug?: string;
}

const { currentSlug } = Astro.props;

// Flattened to one row per <li> — a per-category map would need each callback
// to return two sibling elements (title + items), which Astro's template
// expressions can't do without a Fragment wrapper per row anyway.
type Row = { kind: 'title'; label: string } | { kind: 'item'; slug: string; title: string };
const rows: Row[] = componentsByCategory().flatMap(({ category, items }) => [
  { kind: 'title', label: category } as const,
  ...items.map((item) => ({ kind: 'item', slug: item.slug, title: item.title }) as const),
]);

const base = import.meta.env.BASE_URL;
---

<ul class="menu w-full">
  {rows.map((row) =>
    row.kind === 'title' ? (
      <li class="menu-title">{row.label}</li>
    ) : (
      <li>
        <a href={`${base}components/${row.slug}/`} class:list={{ 'menu-active': currentSlug === row.slug }}>
          {row.title}
        </a>
      </li>
    )
  )}
</ul>
