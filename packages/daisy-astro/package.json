{
  "name": "daisy-astro",
  "version": "0.0.1",
  "description": "Astro components for every daisyUI 5 component, where each daisyUI variant is a typed prop and every native HTML attribute is forwarded.",
  "keywords": [
    "astro-component",
    "withastro",
    "astro",
    "daisyui",
    "tailwindcss",
    "css",
    "ui",
    "components"
  ],
  "homepage": "https://github.com/ok-98/daisy-astro#readme",
  "bugs": "https://github.com/ok-98/daisy-astro/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ok-98/daisy-astro.git",
    "directory": "packages/daisy-astro"
  },
  "license": "MIT",
  "author": "Kacper Olszanski (https://github.com/ok-98)",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src/components/**/*.astro",
    "src/components/**/*.ts",
    "!src/components/**/*.stories.ts",
    "src/index.ts",
    "src/lib",
    "src/env.d.ts"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepack": "node -e \"fs.copyFileSync('../../README.md','README.md');fs.copyFileSync('../../LICENSE','LICENSE')\""
  },
  "peerDependencies": {
    "astro": "^7.0.0",
    "daisyui": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "cally": "^0.9.0"
  },
  "peerDependenciesMeta": {
    "cally": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@storybook-astro/framework": "1.10.0",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/builder-vite": "10.5.10",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "cally": "0.9.2",
    "daisyui": "5.7.22",
    "storybook": "10.5.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  }
}
