---
import type { HTMLAttributes } from 'astro/types';
import type { DaisySize } from '../../lib/variants';

// Props first — a `const` above this breaks inference (plans/README.md §5c).
/**
 * A keyboard key. Renders a native `kbd` element, which is what assistive
 * tech announces as user input — there is no `as` prop (plan §3a).
 *
 * A shortcut is **several `Kbd`s with plain text between them**, matching
 * daisyUI and the HTML spec — one Kbd per key, with the `+` as caller text.
 * There is no `keys` prop and no separator prop. See the KeyCombination story.
 *
 * (No angle brackets in this comment: a less-than sign anywhere in the
 * frontmatter truncates Astro's TypeScript parse — plans/README.md §5c.)
 *
 * Single characters render square automatically — `min-width` equals `height`,
 * and longer text grows the width only (plan §3b). The thicker bottom border is
 * the keycap effect, and `box-shadow: none` is set deliberately to protect it:
 * adding a `shadow-*` class flattens the key rather than deepening it
 * (plan §3c).
 */
interface Props extends HTMLAttributes<'kbd'> {
  size?: DaisySize;
}

// Full literal class names. NEVER `kbd-${size}` (plans/README.md §1b).
const SIZE: Record<DaisySize, string> = {
  xs: 'kbd-xs',
  sm: 'kbd-sm',
  md: 'kbd-md',
  lg: 'kbd-lg',
  xl: 'kbd-xl',
};

const { size, class: className, ...rest } = Astro.props;
---

<kbd class:list={['kbd', size && SIZE[size], className]} {...rest}>
  <slot />
</kbd>
