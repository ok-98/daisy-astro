---
import { auraClass, type AuraProps } from './aura';

// Props first — a `const` above this breaks inference (plans/README.md §5c).
// The props themselves and the class map live in `./aura.ts`, so the same
// mapping is usable without rendering this component.

/**
 * A rotating conic-gradient light drawn behind whatever you put inside it.
 *
 * **The slot content must stay a direct child.** daisyUI matches the wrapped
 * element to give it the right corner radius and to lift it above the blur, so
 * an element in between causes two silent, cosmetic-looking failures at once:
 * the radius stops matching the child, and the content renders *behind* the
 * glow and looks washed out (plan §3b).
 *
 * **This element is `inline-block`**, so wrapping a full-width card makes the
 * card shrink to its content — which reads as a component bug and is not one.
 * Every doc example either wraps an intrinsically-sized button or gives the
 * card an explicit width. Pass `class="block w-full"` if you want the old flow
 * back (plan §3c).
 *
 * Colour, background and animation duration are **all caller classes**, because
 * none of them is a daisyUI class: `class="text-orange-600"` tints the gradient
 * (see `variant` for which styles honour it), `class="bg-yellow-200"` fills
 * behind it, and `class="duration-2000"` changes the spin speed (plan §1a).
 *
 * Under `prefers-reduced-motion: reduce` daisyUI **slows** every animation
 * fourfold rather than stopping it. That is its call, not this wrapper's — for
 * full stillness pass `class="motion-reduce:animate-none"` (plan §3d).
 */
type Props = AuraProps;

const { variant, size, class: className, ...rest } = Astro.props;
---

<div class:list={[...auraClass({ variant, size }), className]} {...rest}>
  <slot />
</div>
