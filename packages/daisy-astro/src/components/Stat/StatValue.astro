---
import type { HTMLTag, Polymorphic } from 'astro/types';

/**
 * The large bold number. Colour is a caller class — `class="text-primary"` —
 * since daisyUI gives this component no colour axis at all (plan §1).
 *
 * `white-space: nowrap` (plan §3f).
 */
type Props<Tag extends HTMLTag = 'div'> = Polymorphic<{
  /**
   * Defaults to `div`. `as="dd"` inside a `Stats as="dl"`. The UA's
   * `margin-inline-start` on `dd` is already zeroed by Tailwind's preflight,
   * which this package requires, so the grid column is unaffected (plan §3h).
   */
  as: Tag;
}>;

// `Astro.props` is untyped inside a generic component (plans/README.md §5c).
const { as: Tag = 'div', class: className, ...rest } = Astro.props as Props<HTMLTag>;
---

<Tag class:list={['stat-value', className]} {...rest}>
  <slot />
</Tag>
