---
import type { HTMLAttributes } from 'astro/types';

/**
 * A row of controls under the value, for the doc page's account-balance
 * example. Column 1 like the text parts, and `white-space: nowrap`, so several
 * buttons stay on one line and widen the block rather than wrapping (plan §3f).
 */
interface Props extends HTMLAttributes<'div'> {}

const { class: className, ...rest } = Astro.props;
---

<div class:list={['stat-actions', className]} {...rest}>
  <slot />
</div>
