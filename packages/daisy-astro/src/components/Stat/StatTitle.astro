---
import type { HTMLTag, Polymorphic } from 'astro/types';

/**
 * The small dimmed label above (or below — plan §3b) the value.
 *
 * `white-space: nowrap`, like every part except the figure: long text never
 * wraps, it widens the block and eventually scrolls the `Stats` (plan §3f).
 */
type Props<Tag extends HTMLTag = 'div'> = Polymorphic<{
  /**
   * Defaults to `div`. `as="dt"` inside a `Stats as="dl"` (plan §3h).
   */
  as: Tag;
}>;

// `Astro.props` is untyped inside a generic component (plans/README.md §5c).
const { as: Tag = 'div', class: className, ...rest } = Astro.props as Props<HTMLTag>;
---

<Tag class:list={['stat-title', className]} {...rest}>
  <slot />
</Tag>
