---
import type { HTMLAttributes } from 'astro/types';

/**
 * The small dimmed label above (or below — plan §3b) the value.
 *
 * `white-space: nowrap`, like every part except the figure: long text never
 * wraps, it widens the block and eventually scrolls the `Stats` (plan §3f).
 */
interface Props extends HTMLAttributes<'div'> {}

const { class: className, ...rest } = Astro.props;
---

<div class:list={['stat-title', className]} {...rest}>
  <slot />
</div>
