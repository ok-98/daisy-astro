---
import type { HTMLTag, Polymorphic } from 'astro/types';

/**
 * One block inside a `Stats`. A two-column grid: `StatFigure` is pinned to
 * column 2 and centred across the rows, everything else stacks in column 1 **in
 * source order** — so title / value / desc can be arranged however you like,
 * and the doc page itself varies the order (plan §3a, §3b).
 *
 * The dashed divider between blocks comes from `.stat:not(:last-child)`, so it
 * needs these to be direct children of the `Stats` (plan §3c).
 *
 * `class="place-items-center"` centres the whole block, as the doc page's
 * centered-items example does.
 */
type Props<Tag extends HTMLTag = 'div'> = Polymorphic<{
  /**
   * Defaults to `div`. `.stat` is class-only CSS with no tag selector
   * anywhere **[verified against `daisyui@5.7.22`'s `stat.css`]**, so the tag
   * is the caller's: `as="li"` inside a `Stats` list, `as="a"` for a block
   * that navigates to the detail view it summarises (plan §3h).
   */
  as: Tag;
}>;

// `Astro.props` is untyped inside a generic component (plans/README.md §5c).
const { as: Tag = 'div', class: className, ...rest } = Astro.props as Props<HTMLTag>;
---

<Tag class:list={['stat', className]} {...rest}>
  <slot />
</Tag>
