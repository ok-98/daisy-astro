---
import type { HTMLTag, Polymorphic } from 'astro/types';

/**
 * The small dimmed line under the value. Same styling as `StatTitle`; which of
 * the two reads as the caption is decided by where you put them (plan §3b).
 *
 * `white-space: nowrap` (plan §3f).
 */
type Props<Tag extends HTMLTag = 'div'> = Polymorphic<{
  /**
   * Defaults to `div`. In a description-list `Stats` this is a second `dd`
   * under the same `dt` — legal, and the caption reading is still positional
   * (plan §3b, §3h).
   */
  as: Tag;
}>;

// `Astro.props` is untyped inside a generic component (plans/README.md §5c).
const { as: Tag = 'div', class: className, ...rest } = Astro.props as Props<HTMLTag>;
---

<Tag class:list={['stat-desc', className]} {...rest}>
  <slot />
</Tag>
