---
import type { HTMLAttributes } from 'astro/types';

/**
 * The small dimmed line under the value. Same styling as `StatTitle`; which of
 * the two reads as the caption is decided by where you put them (plan §3b).
 *
 * `white-space: nowrap` (plan §3f).
 */
interface Props extends HTMLAttributes<'div'> {}

const { class: className, ...rest } = Astro.props;
---

<div class:list={['stat-desc', className]} {...rest}>
  <slot />
</div>
