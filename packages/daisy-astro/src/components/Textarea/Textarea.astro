---
import type { HTMLAttributes } from 'astro/types';
import type { DaisyColor, DaisySize } from '../../lib/variants';

// Props first — a `const` above this breaks inference (plans/README.md §5c).

/**
 * A multi-line text field.
 *
 * **The initial value is the slot, never a `value` prop.** Astro's typings
 * declare `value` on textarea attributes, but HTML has no such attribute here:
 * passing one renders an inert attribute and an empty field. The text between
 * the tags is the value (plan §0g).
 *
 * That is also why the template below has **no whitespace around the slot**.
 * `textarea` is a raw-text element, so indentation between the tags becomes the
 * field's value — a couple of spaces are enough to suppress `placeholder`
 * entirely and to submit whitespace instead of an empty string, which is
 * exactly the path all six doc examples take (plan §0a).
 *
 * **Size changes the font size only** — not the height, not the padding, which
 * are fixed on the base class. That is unlike every other sized control here,
 * so a size comparison shows a text change rather than a box change (plan
 * §0c). Height is a caller class: `class="h-24"`, as the fieldset example
 * writes it. `rows` is native and needs no prop.
 *
 * On a touch device a focused field renders at 1rem however small its size
 * class — daisyUI stopping iOS Safari from auto-zooming. Not a bug (plan §0d).
 *
 * daisyUI also styles `.textarea` as a **wrapper** around a bare textarea, for
 * adornments, but documents no example of it, so this component does not build
 * it (plan §0f). Responsive sizes are caller classes:
 * `class="textarea-sm lg:textarea-lg"`.
 *
 * **Validation styling is a caller class**, not a prop: add `class="validator"`
 * here and put a `ValidatorHint` **after this element, as a sibling in the same
 * parent** — daisyUI reveals the hint with a general sibling combinator, and
 * `validator` itself only sets `--input-color`, which this component already
 * reads (`plans/components/validator.md` §0b).
 */
interface Props extends HTMLAttributes<'textarea'> {
  /** Border and focus-outline colour. */
  color?: DaisyColor;
  /** Base size — font size only (plan §0c). */
  size?: DaisySize;
  /** No background, border or shadow until focused. */
  ghost?: boolean;
}

// Full literal class names. NEVER `textarea-${color}` — an interpolated class
// gets no CSS from daisyUI (plans/README.md §1b).
const COLOR: Record<DaisyColor, string> = {
  neutral: 'textarea-neutral',
  primary: 'textarea-primary',
  secondary: 'textarea-secondary',
  accent: 'textarea-accent',
  info: 'textarea-info',
  success: 'textarea-success',
  warning: 'textarea-warning',
  error: 'textarea-error',
};

const SIZE: Record<DaisySize, string> = {
  xs: 'textarea-xs',
  sm: 'textarea-sm',
  md: 'textarea-md',
  lg: 'textarea-lg',
  xl: 'textarea-xl',
};

const { color, size, ghost = false, class: className, ...rest } = Astro.props;

const classes = ['textarea', color && COLOR[color], size && SIZE[size], { 'textarea-ghost': ghost }, className];
---

<textarea class:list={classes} {...rest}><slot /></textarea>
