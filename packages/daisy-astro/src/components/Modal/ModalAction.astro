---
import type { HTMLAttributes } from 'astro/types';

/**
 * The button row at the end of a `ModalBox`.
 *
 * For the `dialog` method the close button lives inside a
 * `<form method="dialog">` — submitting a dialog-method form closes the dialog
 * with no JavaScript, which is daisyUI's trick throughout and looks like a
 * mistake until you know it (plan §3c).
 */
interface Props extends HTMLAttributes<'div'> {}

const { class: className, ...rest } = Astro.props;
---

<div class:list={['modal-action', className]} {...rest}>
  <slot />
</div>
