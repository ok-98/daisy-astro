---
import type { HTMLAttributes } from 'astro/types';
import type { DaisySize } from '../../lib/variants';

// Props first — a `const` above this breaks inference (plans/README.md §5c).
type LoadingVariant = 'spinner' | 'dots' | 'ring' | 'ball' | 'bars' | 'infinity';

/**
 * An animated loading indicator. The element **is** the graphic — an SVG mask
 * over a `currentColor` block, animated with SMIL inside the mask itself — so
 * it takes no children (plan §2).
 *
 * Colour comes from the text colour: `class="text-primary"`, or nothing at all
 * inside a `Button`, where it inherits the button's foreground (plan §3a).
 * There is no `color` prop, because that colour is a Tailwind utility rather
 * than a daisyUI class. Badge, Alert and Progress do have one, so this is worth
 * knowing before looking for it.
 *
 * Decorative by default: it is `pointer-events: none` and announces nothing.
 * Add `aria-label="Loading"`, or wrap it in a `role="status"` region, when it
 * is the only thing announcing the wait (plan §3d). Neither is defaulted — a
 * live region on a spinner inside an already-labelled button announces an empty
 * update on every render.
 *
 * Under `prefers-reduced-motion` daisyUI **slows** the animation rather than
 * stopping it, which is inverted from the usual pattern (plan §3c). A caller
 * who wants full stillness adds `motion-reduce:animate-none` themselves.
 */
interface Props extends HTMLAttributes<'span'> {
  /**
   * Named `variant`, never `style` — `style` is a native attribute
   * (plans/components/button.md §3a).
   *
   * Omitting it renders the spinner: the base class already carries that mask,
   * so `variant="spinner"` is the explicit form of the default and an unset
   * variant never renders nothing (plan §3b).
   */
  variant?: LoadingVariant;
  size?: DaisySize;
}

// Full literal class names. NEVER `loading-${variant}` (plans/README.md §1b).
const VARIANT: Record<LoadingVariant, string> = {
  spinner: 'loading-spinner',
  dots: 'loading-dots',
  ring: 'loading-ring',
  ball: 'loading-ball',
  bars: 'loading-bars',
  infinity: 'loading-infinity',
};

const SIZE: Record<DaisySize, string> = {
  xs: 'loading-xs',
  sm: 'loading-sm',
  md: 'loading-md',
  lg: 'loading-lg',
  xl: 'loading-xl',
};

const { variant, size, class: className, ...rest } = Astro.props;
---

<span class:list={['loading', variant && VARIANT[variant], size && SIZE[size], className]} {...rest}
></span>
