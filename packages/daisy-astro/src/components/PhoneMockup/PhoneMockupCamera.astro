---
import type { HTMLAttributes } from 'astro/types';

/**
 * The notch pill.
 *
 * **Empty by design** — it takes no children and renders none. The element *is*
 * the graphic, a fixed-proportion black pill, and it is what makes the parent a
 * grid rather than a flex column: it overlaps the display rather than sitting
 * above it (plan §3a).
 */
interface Props extends HTMLAttributes<'div'> {}

const { class: className, ...rest } = Astro.props;
---

<div class:list={['mockup-phone-camera', className]} {...rest}></div>
