---
// Type guard for every implemented component. Renders nothing and is never
// imported — it exists so `astro check` has a *usage* of each component's
// props.
//
// Why this file exists: a component whose `Props` stops being inferred still
// renders correctly and still passes `astro check`, because nothing in `src`
// uses it — story files are `.ts`, and `astro check` does not type-check story
// args against component props. Mask shipped broken exactly that way for one
// commit (plans/README.md §5c). Throwaway probes catch it once; this catches it
// every run.
//
// Add a line per component as it lands: the props it is actually used with,
// including at least one native attribute of its default element passed
// WITHOUT `as` — that is the case the polymorphic default-type-parameter rule
// exists for. Lines that must NOT compile belong in a throwaway probe, not
// here.
import Alert from './components/Alert/Alert.astro';
import Aura from './components/Aura/Aura.astro';
import Avatar from './components/Avatar/Avatar.astro';
import AvatarGroup from './components/Avatar/AvatarGroup.astro';
import Badge from './components/Badge/Badge.astro';
import Breadcrumbs from './components/Breadcrumbs/Breadcrumbs.astro';
import BrowserMockup from './components/BrowserMockup/BrowserMockup.astro';
import Button from './components/Button/Button.astro';
import Card from './components/Card/Card.astro';
import CardActions from './components/Card/CardActions.astro';
import CardBody from './components/Card/CardBody.astro';
import CardTitle from './components/Card/CardTitle.astro';
import CodeMockup from './components/CodeMockup/CodeMockup.astro';
import Carousel from './components/Carousel/Carousel.astro';
import CarouselItem from './components/Carousel/CarouselItem.astro';
import Countdown from './components/Countdown/Countdown.astro';
import CountdownValue from './components/Countdown/CountdownValue.astro';
import Diff from './components/Diff/Diff.astro';
import Divider from './components/Divider/Divider.astro';
import Dock from './components/Dock/Dock.astro';
import DockItem from './components/Dock/DockItem.astro';
import DockLabel from './components/Dock/DockLabel.astro';
import Menu from './components/Menu/Menu.astro';
import MenuTitle from './components/Menu/MenuTitle.astro';
import Modal from './components/Modal/Modal.astro';
import ModalAction from './components/Modal/ModalAction.astro';
import ModalBox from './components/Modal/ModalBox.astro';
import Otp from './components/Otp/Otp.astro';
import Progress from './components/Progress/Progress.astro';
import Radio from './components/Radio/Radio.astro';
import Range from './components/Range/Range.astro';
import RadialProgress from './components/RadialProgress/RadialProgress.astro';
import Skeleton from './components/Skeleton/Skeleton.astro';
import Hover3dCard from './components/Hover3dCard/Hover3dCard.astro';
import HoverGallery from './components/HoverGallery/HoverGallery.astro';
import Kbd from './components/Kbd/Kbd.astro';
import Link from './components/Link/Link.astro';
import Loading from './components/Loading/Loading.astro';
import Mask from './components/Mask/Mask.astro';
import PhoneMockup from './components/PhoneMockup/PhoneMockup.astro';
import PhoneMockupCamera from './components/PhoneMockup/PhoneMockupCamera.astro';
import PhoneMockupDisplay from './components/PhoneMockup/PhoneMockupDisplay.astro';
import Status from './components/Status/Status.astro';
import Swap from './components/Swap/Swap.astro';
import SwapIndeterminate from './components/Swap/SwapIndeterminate.astro';
import SwapOff from './components/Swap/SwapOff.astro';
import SwapOn from './components/Swap/SwapOn.astro';
import WindowMockup from './components/WindowMockup/WindowMockup.astro';
import Tab from './components/Tab/Tab.astro';
import TabContent from './components/Tab/TabContent.astro';
import Tabs from './components/Tab/Tabs.astro';
import TextRotate from './components/TextRotate/TextRotate.astro';
import Tooltip from './components/Tooltip/Tooltip.astro';
import Timeline from './components/Timeline/Timeline.astro';
import TimelineEnd from './components/Timeline/TimelineEnd.astro';
import TimelineItem from './components/Timeline/TimelineItem.astro';
import TimelineMiddle from './components/Timeline/TimelineMiddle.astro';
import TimelineStart from './components/Timeline/TimelineStart.astro';
import Step from './components/Steps/Step.astro';
import StepIcon from './components/Steps/StepIcon.astro';
import Steps from './components/Steps/Steps.astro';
---

<Button color="primary" size="lg" variant="outline" shape="circle" width="wide" active disabled>ok</Button>
<Button id="b" data-test="y" type="submit" aria-label="Save">ok</Button>
<Button as="a" href="/ok" disabled>ok</Button>
<Button as="input" type="submit" value="Go" />

<Badge color="primary" variant="soft" size="lg">ok</Badge>
<Badge id="b" data-test="y" title="t">ok</Badge>
<Badge as="div">ok</Badge>
<Badge as="a" href="/ok">ok</Badge>

<Avatar presence="online" placeholder innerClass="w-16" aria-label="AI, online">ok</Avatar>
<Avatar id="a" data-test="y" class="mx-2" style="opacity:.9">ok</Avatar>
<AvatarGroup class="-space-x-6"><Avatar innerClass="w-12">ok</Avatar></AvatarGroup>

<Mask shape="squircle" src="/a.webp" alt="A" class="w-40 h-40" />
<Mask shape="star" half="1" class="w-20 h-40" src="/a.webp" alt="A" />
<Mask as="div" shape="heart" class="w-24">ok</Mask>

<Breadcrumbs><li>Home</li></Breadcrumbs>
<Breadcrumbs as="div" listAs="ol" class="text-sm" aria-label="You are here" id="bc" data-test="y"><li>Home</li></Breadcrumbs>

<Carousel class="w-96 rounded-box"><CarouselItem id="slide1" class="w-full">ok</CarouselItem></Carousel>
<Carousel snap="center" direction="vertical" class="h-96" tabindex="0" aria-label="Photos" id="cr" data-test="y">ok</Carousel>

<Countdown class="font-mono text-2xl"><CountdownValue value={59} /></Countdown>
<CountdownValue value={24} digits={2} class="mine" style="color:red" id="cv" data-test="y" />

<Diff class="aspect-16/9 rounded-field" item1Label="After" item2Label="Before" id="df" data-test="y" tabindex="-1">x</Diff>

<Dock size="xs" class="relative" id="dk" data-test="y"><DockItem active aria-current="page"><DockLabel class="mine">Home</DockLabel></DockItem></Dock>
<DockItem as="a" href="/inbox">ok</DockItem>
<DockItem disabled>ok</DockItem>

<Divider>OR</Divider>
<Divider />
<Divider color="primary" direction="horizontal" placement="start" role="separator" id="d" data-test="y">Start</Divider>

<Progress class="w-56" value={40} max={100} />
<Progress class="w-56" />
<Progress color="primary" class="w-56 h-4" id="p" data-test="y" aria-label="Upload" />

<RadialProgress value={70}>70%</RadialProgress>
<RadialProgress value={70} size="12rem" thickness="2px" class="text-primary" style="opacity:.5" id="r" data-test="y" />

<Menu direction="horizontal" size="lg" paged class="w-56" id="mn" data-test="y">
  <MenuTitle id="mt">Title</MenuTitle>
  <MenuTitle as="h2" class="mine">Group</MenuTitle>
</Menu>

<Modal id="m1" position="bottom" align="end" open class="sm:modal-middle" data-test="y">
  <ModalBox class="w-11/12" id="mb"><ModalAction id="ma">x</ModalAction></ModalBox>
</Modal>
<Modal as="div" popover id="m2">x</Modal>

<Otp color="primary" size="lg" joined id="ot" data-test="y" class="mine">boxes and input go here</Otp>

<Radio name="plan" value="free" checked />
<Radio name="plan" color="primary" size="lg" disabled id="rd" data-test="y" class="mine" />

<Range min="0" max="100" value="40" />
<Range color="primary" size="lg" step="25" vertical id="rg" data-test="y" class="[--range-fill:0]" />

<Skeleton class="h-32 w-32" />
<Skeleton text as="span">ok</Skeleton>
<Skeleton class="h-16 w-16" id="sk" data-test="y" title="t" />

<Alert color="info" variant="soft" direction="vertical" role="status" id="al" data-test="y">msg</Alert>
<Card as="label" variant="border" size="lg" side imageFull class="w-96" id="cd" data-test="y">
  <CardBody id="cb" class="mine"><CardTitle as="h3" id="ct">T</CardTitle><CardActions class="justify-end" id="ca">a</CardActions></CardBody>
</Card>

<Aura variant="rainbow" size="lg" class="text-primary" id="au" data-test="y">child</Aura>
<Hover3dCard class="mine" id="h3"><div>card</div></Hover3dCard>
<HoverGallery as="figure" class="h-64" id="hg" data-test="y">imgs</HoverGallery>
<Tooltip tip="hello" position="left" align="start" color="primary" open id="tt" data-test="y" class="mine">trigger</Tooltip>
<Tooltip tip="">trigger</Tooltip>

<TextRotate align="center" class="text-7xl" id="tr">items</TextRotate>

<Kbd>K</Kbd>
<Kbd size="lg" id="k" data-test="y" class="mx-1">K</Kbd>

<Link href="/docs">ok</Link>
<Link color="primary" hover class="text-lg" id="l" data-test="y" target="_blank">ok</Link>
<Link as="button" type="button">ok</Link>

<Loading />
<Loading variant="bars" size="lg" class="text-primary" aria-label="Loading" />
<Loading id="ld" data-test="y" title="t" />

<Steps><Step color="primary">Register</Step><Step>Purchase</Step></Steps>
<Steps direction="vertical" class="lg:steps-horizontal" id="st" data-test="y"><Step data-content="✓">ok</Step></Steps>
<Step><StepIcon class="mine" id="si">★</StepIcon>Step 3</Step>

<Tabs role="tablist" variant="lift" placement="bottom" size="lg" id="tb" data-test="y"><Tab role="tab" active>Tab 1</Tab></Tabs>
<Tab as="input" type="radio" name="t1" aria-label="Tab 1" />
<Tab as="label" disabled class="mine">Live</Tab>
<TabContent class="p-6" id="tc">panel</TabContent>

<Timeline direction="vertical" compact snapIcon class="lg:timeline-horizontal" id="tl" data-test="y">
  <TimelineItem lineBefore={false} lineAfterClass="bg-primary" class="mine" id="ti">
    <TimelineStart box>1984</TimelineStart>
    <TimelineMiddle>icon</TimelineMiddle>
    <TimelineEnd box>First Macintosh</TimelineEnd>
  </TimelineItem>
</Timeline>

<WindowMockup class="border w-full" id="wm" data-test="y">Hello!</WindowMockup>
<CodeMockup class="w-full" id="cm">code</CodeMockup>
<BrowserMockup class="border w-full" id="bm"><div class="input" slot="toolbar">url</div>Hello!</BrowserMockup>
<PhoneMockup class="w-64" id="pm"><PhoneMockupCamera class="mine" /><PhoneMockupDisplay class="text-white" id="pd">hi</PhoneMockupDisplay></PhoneMockup>

<Swap as="div" active effect="rotate" class="mine" id="sw" data-test="y">
  <SwapOn id="son">ON</SwapOn><SwapOff id="soff">OFF</SwapOff><SwapIndeterminate>-</SwapIndeterminate>
</Swap>

<Status />
<Status color="success" size="lg" aria-label="Online" />
<Status id="s" data-test="y" title="t" class="animate-bounce" />
<Status as="div" aria-hidden="true" />
